{
  "name": "agent-workflow-contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "npm run generate:go && npm run generate:ts",
    "generate:go": "mkdir -p pkg/contractsv1 && go run github.com/atombender/go-jsonschema@v0.24.1 --package contractsv1 --struct-name-from-title --only-models --tags json --output pkg/contractsv1/zz_generated.go contracts/codegen.v1.schema.json",
    "generate:ts": "mkdir -p web/src/generated && sh scripts/generate-types.sh web/src/generated/agent-workflow.v1.ts",
    "fixture:canvas": "sh scripts/generate-canvas-fixture.sh",
    "fixture:conformance": "go run ./scripts/generate-conformance-fixtures.go",
    "conformance": "go run ./cmd/agent-workflow conformance --file conformance/fixtures/generic.json && go run ./cmd/agent-workflow conformance --file conformance/fixtures/seo-shaped.json",
    "check:generated": "sh scripts/check-generated.sh",
    "check:types": "tsc --noEmit -p web/tsconfig.json",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:embed": "npm run web:build && sh scripts/sync-embedded-web.sh",
    "check:embedded-web": "npm run web:build && diff -qr web/dist internal/webassets/dist",
    "web:test": "vitest run --config web/vite.config.ts",
    "web:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "quicktype": "26.0.0",
    "typescript": "5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.11.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  }
}
